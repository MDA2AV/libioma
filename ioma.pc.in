prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/ioma

Name: ioma
Description: HTTP/1.1 server framework on a thread-per-core io_uring runtime
Version: @VERSION@
URL: https://github.com/MDA2AV/ioma
Libs: -L${libdir} -lioma -pthread
Cflags: -I${includedir} -pthread
